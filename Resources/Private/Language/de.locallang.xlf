<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:videooptimizer/Resources/Private/Language/locallang.xlf" product-name="videooptimizer">
        <body>
            <trans-unit id="vo_group.video">
                <source>Video</source>
                <target>Video</target>
            </trans-unit>
            <trans-unit id="vo_ct.videohero.label">
                <source>Video Hero</source>
                <target>Video-Hero</target>
            </trans-unit>
            <trans-unit id="vo_ct.videohero.description">
                <source>Full-bleed hero section with a background video.</source>
                <target>Bildschirmbreiter Hero-Bereich mit Hintergrundvideo.</target>
            </trans-unit>
            <trans-unit id="vo_ct.videosingle.label">
                <source>Video Single</source>
                <target>Einzelvideo</target>
            </trans-unit>
            <trans-unit id="vo_ct.videosingle.description">
                <source>A single video player with its title.</source>
                <target>Ein einzelner Videoplayer mit Titel.</target>
            </trans-unit>
            <trans-unit id="vo_ct.videogrid.label">
                <source>Video Grid</source>
                <target>Video-Raster</target>
            </trans-unit>
            <trans-unit id="vo_ct.videogrid.description">
                <source>A responsive grid of videos from the library.</source>
                <target>Ein responsives Raster mit Videos aus der Bibliothek.</target>
            </trans-unit>
            <trans-unit id="vo_ct.videolist.label">
                <source>Video List</source>
                <target>Video-Liste</target>
            </trans-unit>
            <trans-unit id="vo_ct.videolist.description">
                <source>A compact list of videos from the library.</source>
                <target>Eine kompakte Liste mit Videos aus der Bibliothek.</target>
            </trans-unit>
            <trans-unit id="vo_ct.videodetail.label">
                <source>Video Detail</source>
                <target>Video-Detail</target>
            </trans-unit>
            <trans-unit id="vo_ct.videodetail.description">
                <source>A single video with embed player and metadata.</source>
                <target>Ein einzelnes Video mit Player und Metadaten.</target>
            </trans-unit>
            <trans-unit id="vo_video_uuid.label">
                <source>Video</source>
                <target>Video</target>
            </trans-unit>
            <trans-unit id="vo_video_uuid.description">
                <source>Choose a video from the library selected above. With "All libraries", videos are grouped by library. Leave empty to use the default demo video.</source>
                <target>Wählen Sie ein Video aus der oben gewählten Bibliothek. Bei „Alle Bibliotheken“ sind die Videos nach Bibliothek gruppiert. Leer lassen, um das Demo-Video zu verwenden.</target>
            </trans-unit>
            <trans-unit id="vo_library_id.label">
                <source>Library</source>
                <target>Bibliothek</target>
            </trans-unit>
            <trans-unit id="vo_library_id.description">
                <source>Click a library tile. Grid and list show the videos of this library; the video browser of single, hero and detail elements opens with this library. Select "All libraries" for no restriction.</source>
                <target>Klicken Sie auf eine Bibliothek. Raster und Liste zeigen die Videos dieser Bibliothek; die Videoauswahl von Einzelvideo, Hero und Detail öffnet sich mit dieser Bibliothek. „Alle Bibliotheken“ hebt die Einschränkung auf.</target>
            </trans-unit>
            <trans-unit id="vo_player.div">
                <source>Player options</source>
                <target>Player-Optionen</target>
            </trans-unit>
            <trans-unit id="vo_player.autoplay">
                <source>Autoplay</source>
                <target>Autoplay</target>
            </trans-unit>
            <trans-unit id="vo_player.loop">
                <source>Loop</source>
                <target>Schleife</target>
            </trans-unit>
            <trans-unit id="vo_player.muted">
                <source>Muted</source>
                <target>Stumm</target>
            </trans-unit>
            <trans-unit id="vo_player.controls">
                <source>Show player controls</source>
                <target>Player-Steuerung anzeigen</target>
            </trans-unit>
            <trans-unit id="vo_player.start_time">
                <source>Start position (seconds)</source>
                <target>Startposition (Sekunden)</target>
            </trans-unit>
            <trans-unit id="vo_player.fit_cover">
                <source>Cover (fill area, crop instead of letterbox)</source>
                <target>Cover (Fläche füllen, beschneiden statt Balken)</target>
            </trans-unit>
            <trans-unit id="vo_player.subtitle_lang">
                <source>Subtitle language</source>
                <target>Untertitelsprache</target>
            </trans-unit>
            <trans-unit id="vo_player.subtitle_lang.default">
                <source>-- Player default --</source>
                <target>-- Player-Standard --</target>
            </trans-unit>
            <trans-unit id="vo_hero.div">
                <source>Hero</source>
                <target>Hero</target>
            </trans-unit>
            <trans-unit id="vo_hero_eyebrow.label">
                <source>Eyebrow text (empty = "VideoOptimizer")</source>
                <target>Dachzeile (leer = „VideoOptimizer“)</target>
            </trans-unit>
            <trans-unit id="vo_hero_subtitle.label">
                <source>Subtitle</source>
                <target>Untertitel</target>
            </trans-unit>
            <trans-unit id="vo_hero_subtitle.description">
                <source>Replaces the automatic line (duration, resolution, views). Empty = automatic.</source>
                <target>Ersetzt die automatische Zeile (Dauer, Auflösung, Aufrufe). Leer = automatisch.</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_label.label">
                <source>Button label</source>
                <target>Button-Beschriftung</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_label.placeholder">
                <source>Watch video</source>
                <target>Video ansehen</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_mode.label">
                <source>Button action</source>
                <target>Button-Aktion</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_mode.newtab">
                <source>Open player in a new tab</source>
                <target>Player in neuem Tab öffnen</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_mode.lightbox">
                <source>Open video in lightbox</source>
                <target>Video in Lightbox öffnen</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_mode.link">
                <source>Link to a page or URL</source>
                <target>Auf Seite oder URL verlinken</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_mode.none">
                <source>No button</source>
                <target>Kein Button</target>
            </trans-unit>
            <trans-unit id="vo_hero_cta_link.label">
                <source>Button link</source>
                <target>Button-Link</target>
            </trans-unit>
            <trans-unit id="vo_hero_overlay.label">
                <source>Overlay strength</source>
                <target>Abdunklung</target>
            </trans-unit>
            <trans-unit id="vo_hero_overlay.none">
                <source>None</source>
                <target>Keine</target>
            </trans-unit>
            <trans-unit id="vo_hero_overlay.light">
                <source>Light</source>
                <target>Leicht</target>
            </trans-unit>
            <trans-unit id="vo_hero_overlay.medium">
                <source>Medium (default)</source>
                <target>Mittel (Standard)</target>
            </trans-unit>
            <trans-unit id="vo_hero_overlay.strong">
                <source>Strong</source>
                <target>Stark</target>
            </trans-unit>
            <trans-unit id="vo_hero_height.label">
                <source>Height</source>
                <target>Höhe</target>
            </trans-unit>
            <trans-unit id="vo_hero_height.compact">
                <source>Compact (about 50% of the viewport)</source>
                <target>Kompakt (ca. 50 % der Fensterhöhe)</target>
            </trans-unit>
            <trans-unit id="vo_hero_height.default">
                <source>Default (440 px)</source>
                <target>Standard (440 px)</target>
            </trans-unit>
            <trans-unit id="vo_hero_height.full">
                <source>Full screen (100% of the viewport)</source>
                <target>Vollbild (100 % der Fensterhöhe)</target>
            </trans-unit>
            <trans-unit id="vo_hero_align.label">
                <source>Text alignment</source>
                <target>Textausrichtung</target>
            </trans-unit>
            <trans-unit id="vo_hero_align.left">
                <source>Left</source>
                <target>Links</target>
            </trans-unit>
            <trans-unit id="vo_hero_align.center">
                <source>Centered</source>
                <target>Zentriert</target>
            </trans-unit>
            <trans-unit id="vo_player_mode.label">
                <source>Player</source>
                <target>Player</target>
            </trans-unit>
            <trans-unit id="vo_player_mode.description">
                <source>Hosted: the VideoOptimizer player in an iframe. Native: a video element with the player code and hls.js loaded only when needed (no iframe, subtitles and theme applied).</source>
                <target>Gehostet: der VideoOptimizer-Player in einem iframe. Nativ: ein Video-Element; Player-Code und hls.js werden nur bei Bedarf geladen (kein iframe, Untertitel und Theme werden übernommen).</target>
            </trans-unit>
            <trans-unit id="vo_player_mode.hosted">
                <source>Hosted (iframe)</source>
                <target>Gehostet (iframe)</target>
            </trans-unit>
            <trans-unit id="vo_player_mode.native">
                <source>Native (video element)</source>
                <target>Nativ (Video-Element)</target>
            </trans-unit>
            <trans-unit id="vo_presentation.label">
                <source>Presentation</source>
                <target>Darstellung</target>
            </trans-unit>
            <trans-unit id="vo_presentation.description">
                <source>Direct: the player is shown right away. Facade: poster with play button, the player loads on click. Lightbox: poster with play button, the player opens in a dialog.</source>
                <target>Direkt: der Player wird sofort angezeigt. Fassade: Vorschaubild mit Play-Button, der Player lädt erst beim Klick. Lightbox: Vorschaubild mit Play-Button, der Player öffnet sich in einem Dialog.</target>
            </trans-unit>
            <trans-unit id="vo_presentation.direct">
                <source>Direct</source>
                <target>Direkt</target>
            </trans-unit>
            <trans-unit id="vo_presentation.facade">
                <source>Facade (click to play)</source>
                <target>Fassade (Klick zum Abspielen)</target>
            </trans-unit>
            <trans-unit id="vo_presentation.lightbox">
                <source>Lightbox (dialog)</source>
                <target>Lightbox (Dialog)</target>
            </trans-unit>
            <trans-unit id="vo_ct.videosplit.label">
                <source>Video Split</source>
                <target>Video mit Text</target>
            </trans-unit>
            <trans-unit id="vo_ct.videosplit.description">
                <source>Video next to text: eyebrow, headline, rich text and an optional button.</source>
                <target>Video neben Text: Eyebrow, Überschrift, Fließtext und optional ein Button.</target>
            </trans-unit>
            <trans-unit id="vo_ct.videospotlight.label">
                <source>Video Spotlight</source>
                <target>Video-Spotlight</target>
            </trans-unit>
            <trans-unit id="vo_ct.videospotlight.description">
                <source>One prominent, centered video with eyebrow, headline and caption.</source>
                <target>Ein hervorgehobenes, zentriertes Video mit Eyebrow, Überschrift und Bildunterschrift.</target>
            </trans-unit>
            <trans-unit id="vo_eyebrow.label">
                <source>Eyebrow</source>
                <target>Eyebrow (Kicker)</target>
            </trans-unit>
            <trans-unit id="vo_caption.label">
                <source>Caption</source>
                <target>Bildunterschrift</target>
            </trans-unit>
            <trans-unit id="vo_split_side.label">
                <source>Video position</source>
                <target>Position des Videos</target>
            </trans-unit>
            <trans-unit id="vo_split_side.left">
                <source>Left of the text</source>
                <target>Links vom Text</target>
            </trans-unit>
            <trans-unit id="vo_split_side.right">
                <source>Right of the text</source>
                <target>Rechts vom Text</target>
            </trans-unit>
            <trans-unit id="vo_cta_label.label">
                <source>Button label</source>
                <target>Button-Beschriftung</target>
            </trans-unit>
            <trans-unit id="vo_cta_link.label">
                <source>Button link</source>
                <target>Button-Link</target>
            </trans-unit>
            <trans-unit id="vo_ct.videochapters.label">
                <source>Video Chapters</source>
                <target>Video mit Kapiteln</target>
            </trans-unit>
            <trans-unit id="vo_ct.videochapters.description">
                <source>The video with a row of scene previews; a click jumps to the scene.</source>
                <target>Das Video mit einer Reihe von Szenenvorschauen; ein Klick springt zur Szene.</target>
            </trans-unit>
            <trans-unit id="vo_scene_count.label">
                <source>Number of scenes (3-10)</source>
                <target>Anzahl der Szenen (3-10)</target>
            </trans-unit>
            <trans-unit id="vo_scene_titles.label">
                <source>Scene titles</source>
                <target>Szenentitel</target>
            </trans-unit>
            <trans-unit id="vo_scene_titles.description">
                <source>One title per line, in the order of the scenes. Empty lines keep "Scene n".</source>
                <target>Ein Titel pro Zeile, in der Reihenfolge der Szenen. Leere Zeilen behalten „Szene n“.</target>
            </trans-unit>
            <trans-unit id="vo_format.label">
                <source>Format</source>
                <target>Format</target>
            </trans-unit>
            <trans-unit id="vo_format.description">
                <source>Crops the video to a fixed aspect ratio (the video fills it, native player and poster). In a lightbox only the poster takes the format. The hosted player ignores the focal point.</source>
                <target>Beschneidet das Video auf ein festes Seitenverhältnis (das Video füllt die Fläche, nativer Player und Poster). In einer Lightbox übernimmt nur das Poster das Format. Der gehostete Player ignoriert den Bildausschnitt.</target>
            </trans-unit>
            <trans-unit id="vo_format.original">
                <source>Original (video ratio)</source>
                <target>Original (Seitenverhältnis des Videos)</target>
            </trans-unit>
            <trans-unit id="vo_focus_x.label">
                <source>Focal point X (%)</source>
                <target>Bildausschnitt X (%)</target>
            </trans-unit>
            <trans-unit id="vo_focus_x.description">
                <source>Which part stays visible when the format crops the video: 0 = left/top, 50 = center, 100 = right/bottom.</source>
                <target>Welcher Teil sichtbar bleibt, wenn das Format das Video beschneidet: 0 = links/oben, 50 = Mitte, 100 = rechts/unten.</target>
            </trans-unit>
            <trans-unit id="vo_focus_y.label">
                <source>Focal point Y (%)</source>
                <target>Bildausschnitt Y (%)</target>
            </trans-unit>
        </body>
    </file>
</xliff>
