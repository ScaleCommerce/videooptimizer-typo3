                <source>No VideoOptimizer API token configured. Set it in the extension configuration (apiToken) or in the environment variable VO_API_TOKEN.</source>
                <target>Kein VideoOptimizer-API-Token konfiguriert. Hinterlegen Sie es in der Extension-Konfiguration (apiToken) oder in der Umgebungsvariable VO_API_TOKEN.</target>
            </trans-unit>
            <trans-unit id="error.api" approved="yes">
                <source>The video could not be loaded from VideoOptimizer.</source>
                <target>Das Video konnte nicht von VideoOptimizer geladen werden.</target>
            </trans-unit>
            <trans-unit id="video.fallback_title" approved="yes">
                <source>Video %s</source>
                <target>Video %s</target>
            </trans-unit>
            <trans-unit id="video.unavailable" approved="yes">
                <source>This video is currently unavailable.</source>
                <target>Dieses Video ist derzeit nicht verfügbar.</target>
            </trans-unit>
            <trans-unit id="video.processing" approved="yes">
                <source>Video is being processed</source>
                <target>Video wird verarbeitet</target>
            </trans-unit>
